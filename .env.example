# Set this in Vercel to the production site's canonical, absolute URL.
# It takes precedence over Vercel's automatically supplied deployment hostnames.
# Preview deployments fall back to VERCEL_URL, and local development safely
# falls back to http://localhost:3000 when this value is empty or absent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Every variable below is server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
# A verified Resend sender, for example: SiteSimple <inquiries@example.com>
INQUIRY_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_REPLY_TO_EMAIL=

# A long, random secret used only to hash rate-limit fingerprints.
INQUIRY_RATE_LIMIT_SALT=
